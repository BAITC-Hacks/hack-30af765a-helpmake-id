# Frontend origins. Docker Compose reads backend/.env automatically.
CORS_ORIGINS=https://helpmake-id.live,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional OpenAI-compatible explanation provider. Use API keys, not promotional
# credit codes. Keep credentials in local .env.
AI_API_URL=
AI_API_KEY=
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=
AI_MODEL=

# Optional for local uvicorn. Compose uses its persistent named volume.
SCENARIO_DB_PATH=
