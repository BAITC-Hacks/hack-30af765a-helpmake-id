# Application
APP_NAME=templ
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-before-deploying
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/templ

# Test database (used by pytest; isolated from the main database)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/templ_test

# HTTP client
HTTP_CLIENT_TIMEOUT=30.0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File upload
MAX_UPLOAD_SIZE_MB=10
